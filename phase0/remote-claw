#!/usr/bin/env python3
"""remote-claw CLI entrypoint — see `remote-claw --help`.

Thin shim that runs the `remote_claw` package (kept stdlib-only, no install step).
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from remote_claw.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
