#!/usr/bin/env python3
"""remote-claw — drive a real `claude --remote-control` session from your own
relay + client, with the local TUI and your remote client sharing one session.

Architecture (see ../docs/phase0-findings.md §4c):
  claude --remote-control  ──HTTPS_PROXY──▶  relay (MITM of api.anthropic.com)
       (local TUI)                              ├─ intercepts /v1/code/sessions* (the relay)
                                                ├─ passes /v1/messages through (inference)
                                                └─ client UI/API on :9100  ◀── your browser

Commands:
  remote-claw doctor                 check environment (claude, openssl, certs, ports)
  remote-claw certs                  generate the MITM CA + leaf cert (idempotent)
  remote-claw relay [-v]             run the relay in the foreground
  remote-claw worker [NAME] [...]    launch claude --remote-control pointed at the relay
  remote-claw up [NAME] [...]        start the relay (background) + worker (foreground TUI)
  remote-claw stop                   stop a background relay and any workers
  remote-claw test                   run the automated end-to-end test

Common options:
  --permission-mode {default,acceptEdits,plan,bypassPermissions}
  --proxy-port N (default 8888)   --client-port N (default 9100)
  -v/--verbose
"""
import argparse, os, signal, socket, subprocess, sys, time

ROOT = os.path.dirname(os.path.abspath(__file__))
CERTS = os.path.join(ROOT, "mitm", "certs")
RELAY = os.path.join(ROOT, "relay", "relay.py")
TEST = os.path.join(ROOT, "test", "e2e.py")
CA = os.path.join(CERTS, "ca.pem")
PIDFILE = "/tmp/remote-claw-relay.pid"

C = {"g": "\033[32m", "r": "\033[31m", "y": "\033[33m", "b": "\033[1m", "x": "\033[0m"}
def ok(m): print(f"{C['g']}✓{C['x']} {m}")
def bad(m): print(f"{C['r']}✗{C['x']} {m}")
def info(m): print(f"{C['y']}•{C['x']} {m}")

def which(p):
    for d in os.environ.get("PATH", "").split(os.pathsep):
        f = os.path.join(d, p)
        if os.path.isfile(f) and os.access(f, os.X_OK):
            return f
    return None

def port_free(port):
    s = socket.socket()
    try:
        s.bind(("127.0.0.1", port)); return True
    except OSError:
        return False
    finally:
        s.close()

# ───────────────────────── certs ─────────────────────────
def gen_certs(force=False):
    os.makedirs(CERTS, exist_ok=True)
    if os.path.exists(CA) and not force:
        info(f"certs already present in {CERTS} (use --force to regenerate)")
        return
    def run(cmd): subprocess.run(cmd, check=True, cwd=CERTS,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    run(["openssl", "genrsa", "-out", "ca.key", "2048"])
    run(["openssl", "req", "-x509", "-new", "-nodes", "-key", "ca.key", "-sha256",
         "-days", "30", "-out", "ca.pem", "-subj", "/CN=remote-claw-CA"])
    run(["openssl", "genrsa", "-out", "leaf.key", "2048"])
    run(["openssl", "req", "-new", "-key", "leaf.key", "-out", "leaf.csr",
         "-subj", "/CN=api.anthropic.com"])
    with open(os.path.join(CERTS, "leaf.ext"), "w") as f:
        f.write("subjectAltName=DNS:api.anthropic.com\nextendedKeyUsage=serverAuth\n")
    run(["openssl", "x509", "-req", "-in", "leaf.csr", "-CA", "ca.pem", "-CAkey", "ca.key",
         "-CAcreateserial", "-out", "leaf.pem", "-days", "30", "-sha256",
         "-extfile", "leaf.ext"])
    ok(f"generated CA + leaf cert in {CERTS}")

# ───────────────────────── doctor ─────────────────────────
def doctor(a):
    okall = True
    cl = which("claude")
    if cl:
        try:
            v = subprocess.run([cl, "--version"], capture_output=True, text=True).stdout.strip()
        except Exception:
            v = "?"
        ok(f"claude: {cl} ({v})")
    else:
        bad("claude not found on PATH"); okall = False
    if which("openssl"): ok("openssl present")
    else: bad("openssl not found"); okall = False
    if os.path.exists(CA): ok(f"certs present ({CERTS})")
    else: info("certs not generated yet — run: remote-claw certs");
    for p in (a.proxy_port, a.client_port):
        if port_free(p): ok(f"port {p} free")
        else: bad(f"port {p} in use"); okall = False
    print()
    print(f"{C['b']}auth check:{C['x']}")
    if cl:
        r = subprocess.run([cl, "auth", "status"], capture_output=True, text=True)
        sys.stdout.write(r.stdout)
    return 0 if okall else 1

# ───────────────────────── relay ─────────────────────────
def relay_cmd(a, background=False):
    gen_certs()
    cmd = [sys.executable, RELAY, "--proxy-port", str(a.proxy_port),
           "--client-port", str(a.client_port)]
    if getattr(a, "verbose", False):
        cmd.append("--verbose")
    if background:
        f = open("/tmp/remote-claw-relay.log", "w")
        p = subprocess.Popen(cmd, stdout=f, stderr=f, stdin=subprocess.DEVNULL,
                             start_new_session=True)
        with open(PIDFILE, "w") as pf:
            pf.write(str(p.pid))
        return p
    os.execv(sys.executable, cmd)

def worker_env(a):
    env = dict(os.environ)
    env["HTTPS_PROXY"] = env["HTTP_PROXY"] = f"http://127.0.0.1:{a.proxy_port}"
    env["NODE_EXTRA_CA_CERTS"] = CA
    return env

def worker_cmd(a, exec_=True):
    cl = which("claude") or "claude"
    cmd = [cl, "--remote-control", a.name, "--verbose"]
    if a.permission_mode:
        cmd += ["--permission-mode", a.permission_mode]
    env = worker_env(a)
    if exec_:
        os.execvpe(cmd[0], cmd, env)
    return subprocess.Popen(cmd, env=env)

def wait_port(port, timeout=10):
    end = time.time() + timeout
    while time.time() < end:
        if not port_free(port):
            return True
        time.sleep(0.2)
    return False

def up(a):
    gen_certs()
    if not port_free(a.proxy_port) or not port_free(a.client_port):
        bad("relay ports in use — run `remote-claw stop` first"); return 1
    info("starting relay…")
    p = relay_cmd(a, background=True)
    if not wait_port(a.proxy_port):
        bad("relay failed to start; see /tmp/remote-claw-relay.log"); return 1
    ok(f"relay up (pid {p.pid})  ·  client UI: http://127.0.0.1:{a.client_port}/")
    info(f"launching: claude --remote-control {a.name}"
         + (f" --permission-mode {a.permission_mode}" if a.permission_mode else ""))
    print(f"{C['y']}(the TUI starts below; closing it stops the worker. relay keeps running — "
          f"`remote-claw stop` to end it.){C['x']}\n")
    try:
        worker_cmd(a, exec_=False).wait()
    except KeyboardInterrupt:
        pass
    return 0

def stop(a):
    killed = False
    if os.path.exists(PIDFILE):
        try:
            pid = int(open(PIDFILE).read().strip())
            os.killpg(os.getpgid(pid), signal.SIGTERM); killed = True
            ok(f"stopped relay (pid {pid})")
        except Exception:
            pass
        try: os.remove(PIDFILE)
        except OSError: pass
    # best-effort: stop any workers pointed at our relay
    try:
        subprocess.run(["pkill", "-f", "remote-control"], check=False)
    except Exception:
        pass
    if not killed:
        info("no tracked relay pid; killed any matching processes")
    return 0

def test_cmd(a):
    return subprocess.call([sys.executable, TEST])

# ───────────────────────── argparse ─────────────────────────
def main():
    ap = argparse.ArgumentParser(prog="remote-claw", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--proxy-port", type=int, default=8888)
    ap.add_argument("--client-port", type=int, default=9100)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("doctor")
    pc = sub.add_parser("certs"); pc.add_argument("--force", action="store_true")
    pr = sub.add_parser("relay"); pr.add_argument("-v", "--verbose", action="store_true")
    for name in ("worker", "up"):
        sp = sub.add_parser(name)
        sp.add_argument("name", nargs="?", default="remote-claw")
        sp.add_argument("--permission-mode", choices=["default", "acceptEdits", "plan", "bypassPermissions"])
        sp.add_argument("-v", "--verbose", action="store_true")
    sub.add_parser("stop")
    sub.add_parser("test")

    a = ap.parse_args()
    if a.cmd == "doctor": return doctor(a)
    if a.cmd == "certs": return gen_certs(a.force)
    if a.cmd == "relay": return relay_cmd(a)
    if a.cmd == "worker": return worker_cmd(a)
    if a.cmd == "up": return up(a)
    if a.cmd == "stop": return stop(a)
    if a.cmd == "test": return test_cmd(a)

if __name__ == "__main__":
    sys.exit(main() or 0)
