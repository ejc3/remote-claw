{
  "name": "@remote-claw/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "remote-claw — a transparent wrapper around `claude` (P2). Consumes the reserved --rc-* namespace; forwards everything else.",
  "exports": {
    ".": "./src/index.ts",
    "./broker": "./src/broker/index.ts",
    "./rc": "./src/host/rc/index.ts"
  },
  "dependencies": {
    "@remote-claw/clawsec": "workspace:*"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
