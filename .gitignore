# pnpm workspace root. Dependencies live in the root node_modules (members are symlinked); never
# commit it. The per-package .gitignore files still cover their own build/test artifacts.
node_modules/
dist/
coverage/
*.tsbuildinfo

# Vite / vitest caches
**/.vite
**/.vite-temp

# Workflow DevKit build/test artifacts (compiled step/workflow bundles + run state)
**/.workflow-vitest
**/.workflow-data

# Next.js
**/.next
**/next-env.d.ts
.vercel

# MITM certs generated at runtime by the RC launch path / tests
**/mitm-certs/
