# remote-claw broker — backend configuration. Copy to .env.local for local dev; set the production
# values as Vercel encrypted env vars (Settings → Environment Variables), scoped per environment
# (Production / Preview / Development) so prod / stage / CI can target different stores.

# The supported Claude 1.0 deployment default for the broker routes. A request can override it per-call with the
# `x-broker-backend` header (API clients) or the `?backend=` query param (browser URLs).
#   vercel   — capped Vercel Workflows compatibility/experimental profile; stable Claude rejects it
#   local    — in-process fake broker (dev / tests; single Node process only — no external service)
#   sqlite   — per-session libSQL: ONE database per channel token. The stable production and `pnpm dev`
#              default. Durable across a wrapper restart and physically isolates sessions; storage is
#              local files (dev) or Turso Cloud (prod) — see below.
BROKER_BACKEND=sqlite

# ── Per-session SQLite (BROKER_BACKEND=sqlite) ─────────────────────────────────────────────────
# ONE libSQL database per channel token. The ONLY difference between deployments is WHERE that
# database lives — local file vs Turso Cloud — chosen by the env below. Engine-wide knobs:
#   RC_SQLITE_MAX_CLIENTS — bounded LRU of open per-session libSQL clients (default: 256)
#   RC_SQLITE_POLL_MS     — subscribe live-tail poll interval in ms (default: 150)
#   RC_SQLITE_POLL_QUERY_TIMEOUT_MS — per-query wall; can only tighten the hard 15000 ms maximum
#   RC_SQLITE_SWEEP_BATCH — legacy compatibility knob; ordinary sweep is deliberately non-mutating.
# (file storage opens each session db in WAL mode so reads run concurrently with the writer, matching a
#  remote libSQL; writes serialize structurally — one writer connection per session token.)
#
# LOCAL FILE storage (the `pnpm dev` default — no cloud creds):
#   RC_SQLITE_DIR         — directory holding one `<token>.db` per channel (default: ./.rc-sqlite)
# NOTE: file storage is NOT durable on Vercel (ephemeral, per-instance fs) — the locator fails closed
# there. Use Turso Cloud storage below for a Vercel/production deployment.
#
# TURSO CLOUD storage (one Turso Cloud database per session, created via the Platform API). Set ALL
# four and the sqlite backend uses Turso Cloud instead of local files — no code/flag change:
#   TURSO_API_TOKEN=<turso-platform-api-token>   # creates/looks-up per-session databases (turso auth api-tokens mint)
#   TURSO_ORG=<turso-org-slug>
#   TURSO_GROUP=<group-the-session-dbs-live-in>
#   TURSO_GROUP_AUTH_TOKEN=<group-token>         # libSQL connect credential (auths the whole group; turso group tokens create)
# NOTE: TURSO_GROUP_AUTH_TOKEN is intentionally NOT the usual TURSO_AUTH_TOKEN — the Vercel↔Turso
# integration owns TURSO_AUTH_TOKEN (+ TURSO_DATABASE_URL) for its own per-db managed database, a
# different token scope/org. The per-session fleet needs a GROUP token, so it uses a distinct name to
# avoid colliding with (or being clobbered by) the integration.

# ── Non-mutating SQLite retention route (GET /api/cron/retention) ───────────────────────────────
# The configured daily cron calls ordinary `sweep()`, which deliberately returns zero and deletes or
# compacts nothing: inactivity cannot prove that a session ended, and the broker cannot authenticate a
# safe collection transition from ciphertext. The route remains gated by CRON_SECRET; the same secret
# also protects the independent handoff-expiry cron below.
#   CRON_SECRET=<random-32+-char-secret>   # Vercel env (Production + Preview). Vercel sends it as
#                                          # `Authorization: Bearer $CRON_SECRET`; the route 404s
#                                          # anything else.
#   BROKER_RETENTION_MS=604800000          # legacy validated input; does not authorize deletion.

# ── Preview e2e (CI only) ──────────────────────────────────────────────────────────────────────
# The real-Turso preview proof intentionally retains the opaque databases it creates. The HTTP
# /api/dev/sweep endpoint returns 501 without constructing a locator: a truncated preview scope is not
# exact deployment ownership and therefore cannot authorize deletion. Do not configure a cleanup token;
# any infrastructure cleanup must use a manually reviewed exact database list outside the app.
#
# To run that UI e2e against the per-session sqlite backend on REAL Turso Cloud (the only place the
# cloud locator's Platform-API create + group-token connect run), set the four Turso Cloud vars above
# in the Vercel PREVIEW env, and set a GitHub Actions secret TURSO_CLOUD_E2E=1 to enable the opt-in
# `?backend=sqlite` step in web-preview.yml.

# ── Ephemeral one-time credential handoff (/api/handoff) ───────────────────────────────────────
# The OTK handoff store (docs/ephemeral-handoff.md) — a zero-knowledge, one-time, short-TTL blob store.
# It needs NO new connection creds: on Vercel it REUSES the four Turso Cloud vars above
# (TURSO_API_TOKEN / TURSO_ORG / TURSO_GROUP / TURSO_GROUP_AUTH_TOKEN) via the shared cloud locator,
# in a DEDICATED db (`rc-<scope>-hx`). A `file:` handoff store is rejected on Vercel (per-instance, so a
# PUT and its claim would miss), so those four must be set for the route to function on a Vercel deploy.
# The dedicated frequent sweep (GET /api/cron/handoff-sweep, `*/5 * * * *` in vercel.json) reuses the
# same CRON_SECRET gate documented above (the route 404s anything without the matching Bearer).
#   RC_HANDOFF_TTL_MAX_S=600   # optional: LOWER the handoff TTL ceiling (seconds). The code bakes an
#                              # absolute max of 600 (10 min) and a floor of 30; env can only tighten
#                              # the ceiling within [30, 600], never raise it. Omit ⇒ 600.
