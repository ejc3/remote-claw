# remote-claw broker — backend configuration. Copy to .env.local for local dev; set the production
# values as Vercel encrypted env vars (Settings → Environment Variables), scoped per environment
# (Production / Preview / Development) so prod / stage / CI can target different Temporal namespaces.

# The DEFAULT durable backend for the broker routes. A request can override it per-call with the
# `x-broker-backend` header (API clients) or the `?backend=` query param (browser URLs).
#   vercel   — Vercel Workflows (production default)
#   local    — in-process fake broker (dev / tests; single Node process only — no Vercel/Temporal)
#   temporal — Temporal durable workflows (needs a Temporal server + the relayChannel worker running)
#   sqlite   — per-session libSQL: ONE database per channel token. The primary backend (`pnpm dev`
#              forces it). Durable across a wrapper restart and physically isolates sessions; storage is
#              local files (dev) or Turso Cloud (prod) — see below. Selectable per-request
#              (`?backend=sqlite`) like vercel/temporal.
BROKER_BACKEND=vercel

# ── Per-session SQLite (BROKER_BACKEND=sqlite) ─────────────────────────────────────────────────
# ONE libSQL database per channel token. The ONLY difference between deployments is WHERE that
# database lives — local file vs Turso Cloud — chosen by the env below. Engine-wide knobs:
#   RC_SQLITE_MAX_CLIENTS — bounded LRU of open per-session libSQL clients (default: 256)
#   RC_SQLITE_POLL_MS     — subscribe live-tail poll interval in ms (default: 150)
# (file storage opens each session db in WAL mode so reads run concurrently with the writer, matching a
#  remote libSQL; writes serialize structurally — one writer connection per session token.)
#
# LOCAL FILE storage (the `pnpm dev` default — no cloud creds):
#   RC_SQLITE_DIR         — directory holding one `<token>.db` per channel (default: ./.rc-sqlite)
# NOTE: file storage is NOT durable on Vercel (ephemeral, per-instance fs) — the locator fails closed
# there. Use Turso Cloud storage below for a Vercel/production deployment.
#
# TURSO CLOUD storage (one Turso Cloud database per session, created via the Platform API). Set ALL
# four (e.g. from the Vercel↔Turso integration + a Platform API token) and the sqlite backend uses
# Turso Cloud instead of local files — no code/flag change:
#   TURSO_API_TOKEN=<turso-platform-api-token>   # creates/looks-up per-session databases
#   TURSO_ORG=<turso-org-slug>
#   TURSO_GROUP=<group-the-session-dbs-live-in>
#   TURSO_AUTH_TOKEN=<group-token>               # libSQL connect credential (auths the whole group)

# ── Temporal (used only when the temporal backend is selected) ─────────────────────────────────
# Local dev — the Temporal CLI dev server (`pnpm --filter @remote-claw/web temporal:worker` + the
# `temporal server start-dev` provisioned by scripts/with-temporal.sh):
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=relay

# Temporal Cloud (production / stage / CI) — set these as Vercel secrets, NOT in this file:
#   TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233
#   TEMPORAL_NAMESPACE=<namespace>.<account>
#   TEMPORAL_API_KEY=<temporal-cloud-api-key>      # API-key auth (implies TLS)
# …or mTLS instead of an API key:
#   TEMPORAL_TLS=1
#   TEMPORAL_TLS_CERT_PATH=/secrets/temporal/client.pem
#   TEMPORAL_TLS_KEY_PATH=/secrets/temporal/client.key
# Optional: subscribe() query-poll interval in ms (default 150) — trade latency vs server load:
#   TEMPORAL_POLL_MS=150

# ── Temporal keep-warm worker on Vercel (the GET /api/temporal/drain cron) ─────────────────────
# A per-minute cron (apps/web/vercel.json) keeps a bounded relayChannel worker draining the queue —
# so you don't need a separate always-on worker box. See lib/broker/README.md → Production.
#   CRON_SECRET=<random-32+-char-secret>   # Vercel env (Production + Preview). Vercel sends it as
#                                          # `Authorization: Bearer $CRON_SECRET`; the route 404s
#                                          # anything else. Per-minute crons require a Vercel PRO plan.
#   TEMPORAL_DRAIN_WINDOW_MS=70000         # optional: worker run window per tick (default 70s; must
#                                          # exceed the 60s cron interval so invocations overlap).

# ── Preview e2e (CI only) ──────────────────────────────────────────────────────────────────────
# Set the SAME high-entropy value as a Vercel env var (Preview scope) AND a GitHub Actions secret
# (DEV_SEED_TOKEN). It enables the token-gated /api/dev/seed on a PREVIEW deploy so the Playwright UI
# e2e can run against the vercel backend (web-preview.yml). NEVER set it in the Production scope — the
# route refuses to honour the token when VERCEL_ENV=production.
#   DEV_SEED_TOKEN=<random-32+-char-secret>
