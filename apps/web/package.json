{
  "name": "@remote-claw/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "remote-claw broker and viewer: pluggable Workflow, SQLite/libSQL, and local ciphertext relay with durability/recovery cursors.",
  "scripts": {
    "dev": "BROKER_BACKEND=${BROKER_BACKEND:-sqlite} next dev --webpack",
    "build": "next build --webpack",
    "clean:wdk": "rm -rf .workflow-data .workflow-vitest",
    "test": "vitest",
    "test:run": "vitest run",
    "test:real-claude": "RC_SMOKE_REAL_CLAUDE=1 vitest run test/smoke/real-claude.smoke.test.ts",
    "test:stress": "vitest run test/broker/stress.integration.test.ts",
    "test:stress:heavy": "STRESS_HEAVY=1 vitest run test/broker/stress-local.heavy.test.ts",
    "theme:build": "node scripts/build-theme.mjs",
    "theme:check": "node scripts/build-theme.mjs && git add -N app/theme/built && git diff --exit-code -- app/theme/built",
    "verify:turso-404": "tsx scripts/verify-turso-404.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.8",
    "@astryxdesign/theme-neutral": "0.1.8",
    "@libsql/client": "^0.17.3",
    "@remote-claw/clawsec": "workspace:*",
    "@remote-claw/cli": "workspace:*",
    "@stylexjs/stylex": "^0.19.0",
    "@workflow/errors": "4.1.4",
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "workflow": "4.4.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.1.8",
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.2",
    "@types/react": "19.2.17",
    "@workflow/vitest": "4.0.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
