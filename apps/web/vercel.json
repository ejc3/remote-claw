{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "crons": [
    { "path": "/api/temporal/drain", "schedule": "* * * * *" },
    { "path": "/api/cron/retention", "schedule": "0 3 * * *" }
  ],
  "functions": {
    "app/api/temporal/drain/route.ts": { "maxDuration": 300 },
    "app/api/cron/retention/route.ts": { "maxDuration": 300 }
  }
}
