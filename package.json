{
  "name": "remote-claw",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "remote-claw — an E2E-encrypted multiplayer layer for native coding-agent sessions.",
  "bin": {
    "remote-claw": "dist/remote-claw.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "scripts": {
    "build:cli": "node scripts/build-cli.mjs",
    "check": "biome check .",
    "prepack": "pnpm run build:cli",
    "test:install": "node scripts/test-installed-cli.mjs",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @remote-claw/clawsec --filter @remote-claw/cli --filter @remote-claw/web run test:run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "esbuild": "^0.28.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "@astryxdesign/core": "file:./vendor/astryxdesign-core-0.1.8.tgz"
    }
  }
}
